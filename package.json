{
  "name": "flows",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint && pnpm docs:check",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "docs:index": "pnpm -s --filter @workspace/docs-tools run docs index",
    "docs:check": "pnpm -s --filter @workspace/docs-tools run docs check"
  },
  "devDependencies": {
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-import-x": "^4.18.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
